{
  "name": "posify-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bunx prisma generate && bun build src/index.ts --outdir ./dist",
    "postinstall": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:generate": "bunx prisma generate",
    "db:seed": "bun run prisma/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@prisma/client": "^6.4.0",
    "elysia": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^6.4.0"
  }
}
